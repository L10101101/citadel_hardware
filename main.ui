QPushButton#btnFace,
QPushButton#btnFinger {
    border: 2px solid #4CAF50;
    background-color: #ffffff;
    color: #4CAF50;
    padding: 8px 18px;
    font-weight: bold;
    qproperty-iconSize: 20px;
}

/* left button rounded */
QPushButton#btnFace {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

/* right button rounded */
QPushButton#btnFinger {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* hover (unselected) */
QPushButton#btnFace:hover,
QPushButton#btnFinger:hover {
    background-color: #E6F5E8;
}

/* pressed */
QPushButton#btnFace:pressed,
QPushButton#btnFinger:pressed {
    background-color: #D3EDD7;
}

/* CHECKED — show selected */
QPushButton#btnFace:checked,
QPushButton#btnFinger:checked {
    background-color: #4CAF50;
    color: #ffffff;
}

/* hover while selected */
QPushButton#btnFace:checked:hover,
QPushButton#btnFinger:checked:hover {
    background-color: #43A047;
}

QPushButton#btnSubmit {
    border-radius: 12px;
    border: none;
    background-color: #4CAF50;
    color: white;
    padding: 10px 20px;
    font-weight: bold;
    qproperty-iconSize: 20px;
}

QPushButton#btnSubmit:hover {
    background-color: #43A047; 
}

QPushButton#btnSubmit:pressed {
    background-color: #3C8F3F;
}

QLineEdit#txtStudentNo {
    border: 2px solid #ccc;
    border-radius: 8px;
    padding: 4px 8px;
    background-color: #f9f9f9;
}

QLabel#lblStatus {
    border-radius: 10px;
    padding: 20px 30px;
    background-color: #eee;
    color: #333;
    font-weight: bold;
}

/* Default button style in toolbar */

QToolBar{
	background: white;
}

QToolButton {
    background: transparent;
    padding: 5px 10px;
    margin: 2px 6px;
    border-radius: 8px;
    min-width: 100px;
    color: #333;
}

/* Hover */
QToolBar QToolButton:hover {
    background: #1c855a;
    color: white;
}

/* Pressed */
QToolBar QToolButton:pressed {
    background: #064f32;
    color: white;
}

/* Checked (active tab) */
QToolBar QToolButton:checked {
    background: #064f32;
    color: white;
    border-radius: 4px;
}</string>
