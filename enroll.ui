  <property name="styleSheet">
   <string notr="true">* {
    font-family: 'Poppins-Regular', sans-serif;
}

QMainWindow {
    background-color: #E8EAF0;
}

QWidget#centralWidget {
    background-color: #E8EAF0;
}

QWidget#titleWidget {
    background-color: #064f32;
    max-height: 100px;
}

QWidget#bodyWidget {
    background-color: #E8EAF0;
}

QWidget#detailsWidget {
    background-color: #FFFFFF;
    border-radius: 20px;
}

QWidget#footerWidget {
    background-color: #064f32;
    max-height: 80px;
}

QLabel#logoLabel {
    max-width: 80px;
    max-height: 80px;
    margin: 0px 20px;
}

QLabel#schoolNameLabel {
    color: #fff;
    font-weight: bold;
    font-size: 30px;
    max-width: 500px;
    qproperty-alignment: AlignBottom;
}

QLabel#schoolSubLabel {
    color: #fff;
    font-size: 20px;
}

QLabel#dateTimeLabel {
    color: #fff;
    font-size: 20px;
    margin-right: 20px;
}

QLabel#footerLabel {
    color: #fff;
    font-weight: bold;
    width: 100%;
}

QLabel#cameraFeed {
    background-color: #fff;
    border-radius: 20px;
}

QPushButton#btnFace,
QPushButton#btnFinger {
    border: 2px solid #4CAF50;
    background-color: #ffffff;
    color: #4CAF50;
    padding: 8px 18px;
    font-weight: bold;
    qproperty-iconSize: 20px;
}

QPushButton#btnFace {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

QPushButton#btnFinger {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

QPushButton#btnFace:hover,
QPushButton#btnFinger:hover {
    background-color: #E6F5E8;
}

QPushButton#btnFace:pressed,
QPushButton#btnFinger:pressed {
    background-color: #D3EDD7;
}

QPushButton#btnFace:checked,
QPushButton#btnFinger:checked {
    background-color: #4CAF50;
    color: #ffffff;
}

QPushButton#btnFace:checked:hover,
QPushButton#btnFinger:checked:hover {
    background-color: #43A047;
}

QPushButton#btnSubmit {
    border-radius: 12px;
    border: none;
    background-color: #4CAF50;
    color: white;
    padding: 10px 20px;
    font-weight: bold;
    qproperty-iconSize: 20px;
}

QPushButton#btnSubmit:hover {
    background-color: #43A047; 
}

QPushButton#btnSubmit:pressed {
    background-color: #3C8F3F;
}

QLineEdit#txtStudentNo {
    border: 2px solid #ccc;
    border-radius: 8px;
    padding: 4px 8px;
    background-color: #f9f9f9;
}

QLabel#lblStatus {
    border-radius: 10px;
    padding: 20px 30px;
    background-color: #eee;
    color: #333;
    font-weight: bold;
}</string>
